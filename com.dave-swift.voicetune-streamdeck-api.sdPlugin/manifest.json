{
	"Name": "VoiceTune StreamDeck Hotkeys",
	"Version": "0.3.0.0",
	"Author": "Dave Swift X Michael Schulz",
	"Actions": [
		{
			"Name": "Musik Ein/Aus",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.toggle",
			"Icon": "imgs/actions/icons/play",
			"Tooltip": "Musik einspielen ein/aus",
			"DisableAutomaticStates": true,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/music_toggle_off",
					"Title": "Musik\nAus"
				},
				{
					"Image": "imgs/actions/icons/music_toggle_on",
					"Title": "Musik\nAn"
				}
			]
		},
		{
			"Name": "Mikro stumm",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.micmute",
			"Icon": "imgs/actions/icons/mic_toggle_on",
			"Tooltip": "Mikrofon stumm/an",
			"DisableAutomaticStates": true,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/mic_toggle_on",
					"Title": "Mikro\nAn"
				},
				{
					"Image": "imgs/actions/icons/mic_toggle_off",
					"Title": "Mikro\nStumm"
				}
			]
		},
		{
			"Name": "Play/Pause",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.playpause",
			"Icon": "imgs/actions/icons/play",
			"Tooltip": "Datei-Player Play/Pause",
			"DisableAutomaticStates": true,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/play",
					"Title": "Play"
				},
				{
					"Image": "imgs/actions/icons/pause",
					"Title": "Pause"
				}
			]
		},
		{
			"Name": "Weiter",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.next",
			"Icon": "imgs/actions/icons/vor",
			"Tooltip": "Nächster Titel",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/vor",
					"Title": "Weiter"
				}
			]
		},
		{
			"Name": "Zurück",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.prev",
			"Icon": "imgs/actions/icons/zuruck",
			"Tooltip": "Vorheriger Titel",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/zuruck",
					"Title": "Zurück"
				}
			]
		},
		{
			"Name": "Lauter",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.volup",
			"Icon": "imgs/actions/icons/volume_up",
			"Tooltip": "Musik lauter (+10 %)",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/volume_up",
					"Title": "Lauter"
				}
			]
		},
		{
			"Name": "Leiser",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.voldown",
			"Icon": "imgs/actions/icons/volume_down",
			"Tooltip": "Musik leiser (-10 %)",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/volume_down",
					"Title": "Leiser"
				}
			]
		},
		{
			"Name": "Sound abspielen",
			"UUID": "com.dave-swift.voicetune-streamdeck-api.sound",
			"Icon": "imgs/actions/icons/sound_list",
			"Tooltip": "Spielt einen Soundboard-Platz ab und zeigt an, ob er gerade läuft",
			"PropertyInspectorPath": "ui/sound.html",
			"DisableAutomaticStates": true,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/icons/sound_idle",
					"TitleAlignment": "bottom",
					"FontSize": 12
				},
				{
					"Image": "imgs/actions/icons/sound_active",
					"TitleAlignment": "bottom",
					"FontSize": 12
				}
			]
		}
	],
	"Category": "VoiceTune StreamDeck Hotkeys",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Streamdeck Bedienungselemente für VoiceTune Teamspeak Plugin.\n\nTeamspeak-Plugin: https://github.com/DavidK2709/VoiceTune-TS3/\n\n\n\n\n\n\nby Dave Swift X Michael Schulz",
	"URL": "https://github.com/DavidK2709/VoiceTune-TS3-Streamdeck-API",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.dave-swift.voicetune-streamdeck-api"
}